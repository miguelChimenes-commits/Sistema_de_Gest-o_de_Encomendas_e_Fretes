#define LIMITE 100

// preparando arquivo texto ==============

FILE *arquivo_texto;

// structs ===============================
typedef struct{

    int id;
    int categoria;
    double peso;
    double distancia;
    int cupom;
    double valor_bruto;
    double valor_final;
    char status[10];

}encomendas;

typedef struct{

    double taxa;
    double ml_distancia;

}entrega;

// prototipos ============================
int dialogo(int variavel);
int total_pacotes(int variavel);
double meta_diaria(double variavel);
int ler_inteiro(const char mensagem[], int minimo, int maximo);
double ler_positivo(const char mensagem[]);
bool ler_linha(char linha[], int tamanho);
int registar_pacote(int novos, int quantidade, encomendas pacotes[], entrega categorias[]);
void calcular_frete(encomendas *pacote, entrega categorias[]);
bool frete_gratis(encomendas pacote);
const char *nome_categoria(int categoria);
void comprovante(encomendas pacote);
int carregar_pacotes(encomendas pacotes[]);
bool salvar_pacotes(int quantidade, encomendas pacotes[]);
void listar_pacotes(int quantidade, encomendas pacotes[]);
int buscar_pacote(int quantidade, encomendas pacotes[], int id);
void cancelar_pacote(int quantidade, encomendas pacotes[]);
void resumo(FILE *saida, int quantidade, encomendas pacotes[], double meta);
void exportar_relatorio(int quantidade, encomendas pacotes[], double meta);
bool limpar_historico(void);

int main(void){
    // varivel inportante ================
    double meta_diaria_v = 0;
    int menu = 0;
    int id;
    int posicao;

    // variveel do vetor =================
    int quantidade_de_pacotes = 0;
    int novos_pacotes = 0;
    int registrados = 0;

    // variaveis Categoria de Entrega ====
    entrega padrao = {0.0, 1.20};
    entrega expreca = {15.0, 1.80};
    entrega prioritaria = {30.0, 2.50};

    // vetores ===========================
    encomendas pacotes[LIMITE];
    entrega categorias[3] = {padrao, expreca, prioritaria};

    quantidade_de_pacotes = carregar_pacotes(pacotes);
    if(quantidade_de_pacotes == -1){
        printf("\nNao foi possivel carregar o historico. Arquivo preservado.\n");
        return 1;
    }

    printf("\nHistorico carregado: %d encomenda(s).\n", quantidade_de_pacotes);

    // codigo principal ==================
    for(;;){
        // primeiro dialogo ==========
        menu = dialogo(menu);

        if(menu == 1){
            if(quantidade_de_pacotes >= LIMITE){
                printf("\nLimite de 100 pacotes atingido, incluindo cancelados.\n");
                continue;
            }

            //quantos pacotes no total ===========
            novos_pacotes = total_pacotes(0);
            if(novos_pacotes == 0){
                break;
            }
            if(novos_pacotes > LIMITE - quantidade_de_pacotes){
                printf("\nSo ha espaco para mais %d pacotes.\n", LIMITE - quantidade_de_pacotes);
                continue;
            }

            registrados = registar_pacote(novos_pacotes, quantidade_de_pacotes, pacotes, categorias);
            quantidade_de_pacotes += registrados;

        }else if(menu == 2){
            listar_pacotes(quantidade_de_pacotes, pacotes);

        }else if(menu == 3){
            id = ler_inteiro("Informe o ID: ", 1, LIMITE);
            if(id == -1) break;
            posicao = buscar_pacote(quantidade_de_pacotes, pacotes, id);
            if(posicao == -1){
                printf("\nEncomenda nao localizada.\n");
            }else{
                comprovante(pacotes[posicao]);
            }

        }else if(menu == 4){
            cancelar_pacote(quantidade_de_pacotes, pacotes);

        }else if(menu == 5 || menu == 6){
            if(meta_diaria_v == 0){
                meta_diaria_v = meta_diaria(meta_diaria_v);
            }
            if(meta_diaria_v == 0) break;
            if(menu == 5){
                resumo(stdout, quantidade_de_pacotes, pacotes, meta_diaria_v);
            }else{
                exportar_relatorio(quantidade_de_pacotes, pacotes, meta_diaria_v);
            }

        }else if(menu == 7){
            if(limpar_historico()){
                quantidade_de_pacotes = 0;
                meta_diaria_v = 0;
            }

        }else if(menu == 8){
            break;
        }
    }
    printf("\nPrograma encerrado.\n");
    return 0;
}

