// le uma linha inteira para nao deixar letras sobrando ===
bool ler_linha(char linha[], int tamanho){
    int caractere;
    for(;;){
        if(fgets(linha, tamanho, stdin) == NULL) return false;
        if(strchr(linha, '\n') != NULL || feof(stdin)) return true;
        while((caractere = getchar()) != '\n' && caractere != EOF);
        printf("[ERRO] Entrada muito longa. Digite novamente: ");
    }
}

// valida numeros inteiros e rejeita entradas como 2abc ===
int ler_inteiro(const char mensagem[], int minimo, int maximo){
    char linha[100];
    char sobra;
    double valor;
    for(;;){
        printf("%s", mensagem);
        if(!ler_linha(linha, sizeof(linha))) return -1;
        if(sscanf(linha, "%lf %c", &valor, &sobra) == 1 && isfinite(valor)
           && valor >= minimo && valor <= maximo && valor == (int)valor){
            return (int)valor;
        }
        printf("[ERRO] Digite um inteiro de %d a %d.\n", minimo, maximo);
    }
}

// pesos, distancias e valores usam duas casas decimais ===
double ler_positivo(const char mensagem[]){
    char linha[100];
    char sobra;
    double valor;
    for(;;){
        printf("%s", mensagem);
        if(!ler_linha(linha, sizeof(linha))) return 0;
        if(sscanf(linha, "%lf %c", &valor, &sobra) == 1 && isfinite(valor)
           && valor > 0 && valor <= 1000000000.0){
            valor = round(valor * 100.0) / 100.0;
            if(valor > 0) return valor;
        }
        printf("[ERRO] Digite de 0.01 a 1000000000. Use ponto nos decimais.\n");
    }
}

